# Default placeholder values used by the CLI when generating .env for new projects.
# These are NOT real secrets — just templates for users to fill in.
# Credentials (AUTH_TOKEN, JWT_SECRET_KEY) are deliberately
# absent: env_generator creates them per scaffold, so no default can be guessed.

DOCKER_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_db
DOCKER_DATABASE_URL_PRISMA=postgresql://postgres:postgres@localhost:5433/app_db?schema=public
DOCKER_DIRECT_URL=postgresql://postgres:postgres@localhost:5433/app_db?schema=public

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DIRECT_DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DATABASE_URL_PRISMA=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&schema=public&sslmode=require
SUPABASE_DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=public&sslmode=require

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=11111111-1111-1111-1111-111111111111
ENTRA_API_AUDIENCE=api://11111111-1111-1111-1111-111111111111
ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user
ENTRA_SPA_CLIENT_ID=22222222-2222-2222-2222-222222222222

CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:4300
LOG_LEVEL=INFO
