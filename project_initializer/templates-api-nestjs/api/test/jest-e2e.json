{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "setupFiles": ["<rootDir>/test/support/test-env.ts"],
  "testEnvironment": "node",
  "testTimeout": 20000,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@generated/prisma$": "<rootDir>/generated/prisma/client",
    "^@generated/zod$": "<rootDir>/generated/zod/schemas/index",
    "^@generated/zod/(.*)$": "<rootDir>/generated/zod/schemas/$1",
    "^@/(.*)$": "<rootDir>/src/$1"
  }
}
