# =============================================================================
# NestJS + Supabase Backend - Environment Configuration
# =============================================================================
# This file is used when running NestJS standalone (not via docker-compose)
# For docker-compose, variables are set in docker-compose.yml or root .env
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE - Prisma + Supabase PostgreSQL
# -----------------------------------------------------------------------------
# REQUIRED — the app fails fast at startup if DATABASE_URL or DIRECT_URL is unset.
# See the connection guide at the end of this file.

# Transaction Pooler (port 6543) - runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require&schema=public"  # REQUIRED

# Session Pooler or direct connection (port 5432) - Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require&schema=public"  # REQUIRED

# Local Docker (uncomment for local development):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"

# -----------------------------------------------------------------------------
# SUPABASE AUTH CONFIGURATION
# -----------------------------------------------------------------------------
# Supabase Project URL
# Found in: Settings > API > Project URL
# REQUIRED — app fails fast at startup if unset or not a valid URL. It must use https when
# NODE_ENV=production; plain http is only for the local Supabase CLI (http://127.0.0.1:54321).
SUPABASE_URL=https://your-project.supabase.co  # REQUIRED

# Supabase Publishable Key (sb_publishable_...)
# Found in: Settings > API Keys > Publishable key
# Used to initialize Supabase client for JWT verification. The secret (service-role) key is
# not used by this API and must not be added here: it bypasses Row Level Security.
# REQUIRED — app fails fast at startup if unset
SUPABASE_PUBLISHABLE_KEY=your-publishable-key  # REQUIRED

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Any casing of: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS (default: http://localhost:4200)
CORS_ORIGINS=http://localhost:4200
# Reverse proxies between the client and this process, 0 to 10 (default: 1, the nginx of the
# compose stack). The rate limiter reads the client address that many entries from the right of
# X-Forwarded-For. Use 0 when the API is exposed directly: otherwise a client can spoof the header.
# TRUST_PROXY_HOPS=1
# Publish the OpenAPI UI at /docs (default: on outside production, off in production)
# API_DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# DATABASE RESILIENCE AND HEALTH PROBES (all optional; defaults shown)
# -----------------------------------------------------------------------------
# NODE_ENV=production only: DATABASE_URL must carry sslmode=require, verify-ca or verify-full or
# the app refuses to start. Set true to accept a plaintext connection, and only for a database on
# the same host or a private network that serves no TLS (default: false)
# DB_ALLOW_INSECURE_TRANSPORT=false
# Client-side limits, in milliseconds, so a stalled database cannot hold requests open
# DB_CONNECT_TIMEOUT_MS=5000
# DB_QUERY_TIMEOUT_MS=15000
# Connections per replica in the database pool (default: 10). Prisma's connection_limit URL
# parameter is ignored by the pg driver adapter, so this is the only pool setting.
# DB_POOL_MAX=10
# Consecutive database failures that open the circuit breaker, and how long it stays open
# DB_BREAKER_FAILURE_THRESHOLD=5
# DB_BREAKER_RESET_MS=30000
# Heap ceilings, in megabytes, for the readiness and liveness probes
# HEALTH_HEAP_READINESS_MB=300
# HEALTH_HEAP_LIVENESS_MB=512

# -----------------------------------------------------------------------------
# SUPABASE CONNECTION GUIDE FOR NESTJS + PRISMA
# -----------------------------------------------------------------------------
# The API reaches Postgres through node-postgres (@prisma/adapter-pg), not through Prisma's own
# query engine.
#
# 1. DATABASE_URL (runtime queries): the TRANSACTION POOLER, port 6543.
#    - The adapter sends unnamed prepared statements, which PgBouncer's transaction mode accepts.
#    - Prisma's `pgbouncer=true` and `connection_limit` parameters belong to the old engine and are
#      ignored here. Size the pool with DB_POOL_MAX instead, per replica: keep
#      replicas x DB_POOL_MAX below the pooler's client limit for your compute tier.
#
# 2. DIRECT_URL (migrations): the SESSION POOLER or a direct connection, port 5432.
#    - prisma migrate and prisma db push need a session-level connection; the transaction pooler
#      does not support schema operations.
#
# 3. TLS: `sslmode=require` encrypts the connection without verifying the pooler certificate,
#    which does not chain to Node's default CA bundle. `verify-full` verifies chain and hostname
#    and needs the CA in NODE_EXTRA_CA_CERTS. `sslmode` and the certificate-file parameters are
#    read by the API itself and removed from the string handed to the driver.
#
# 4. Connection string formats:
#    Runtime (DATABASE_URL):
#      postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require&schema=public
#
#    Migrations (DIRECT_URL):
#      postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?schema=public
# -----------------------------------------------------------------------------
